<!-- 首页：美化后的功能入口 -->
<view class="home-page">
  <!-- 顶部装饰背景 -->
  <view class="home-bg">
    <view class="bg-blob bg-blob-1"></view>
    <view class="bg-blob bg-blob-2"></view>
  </view>

  <!-- 标题区 -->
  <view class="hero">
    <view class="hero-badge">Random Picker</view>
    <text class="hero-title">随机决定器</text>
    <text class="hero-sub">纠结的时刻，交给一点随机</text>
  </view>

  <view class="section-head">
    <text class="section-title">选择玩法</text>
    <text class="section-count">共 {{modules.length}} 项</text>
  </view>

  <!-- 功能卡片列表 -->
  <view class="module-list">
    <view
      class="module-card {{item.themeClass}}"
      wx:for="{{modules}}"
      wx:key="id"
      data-url="{{item.url}}"
      bindtap="onTapModule"
    >
      <view class="card-accent" style="background: {{item.theme}};"></view>
      <view class="module-image-wrap">
        <image class="module-image" src="{{item.image}}" mode="aspectFill" />
      </view>
      <view class="module-info">
        <view class="module-title-row">
          <text class="module-title">{{item.title}}</text>
          <text class="module-tag" style="color: {{item.theme}}; border-color: {{item.theme}};">{{item.tag}}</text>
        </view>
        <text class="module-desc">{{item.desc}}</text>
        <view class="module-action" style="background: {{item.theme}};">
          <text>开始</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <text class="footer-tip">点击卡片进入对应功能</text>
</view>
