/**
 * 首页美化样式
 */

/* 页面底色与内边距 */
.home-page {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(165deg, #f0f3ff 0%, #fafbff 35%, #f5f6fa 100%);
}

/* 背景装饰光斑 */
.home-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  pointer-events: none;
  overflow: hidden;
}

.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
}

.bg-blob-1 {
  width: 360rpx;
  height: 360rpx;
  top: -120rpx;
  right: -80rpx;
  background: radial-gradient(circle, rgba(91, 110, 245, 0.25) 0%, transparent 70%);
}

.bg-blob-2 {
  width: 280rpx;
  height: 280rpx;
  top: 80rpx;
  left: -100rpx;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.15) 0%, transparent 70%);
}

/* 标题区 */
.hero {
  position: relative;
  z-index: 1;
  padding: 48rpx 8rpx 40rpx;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #5b6ef5;
  background: rgba(91, 110, 245, 0.1);
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 16rpx;
  line-height: 1.5;
}

/* 分区标题 */
.section-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.section-count {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 卡片列表 */
.module-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.module-card {
  position: relative;
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 28rpx 20rpx;
  box-shadow:
    0 4rpx 6rpx rgba(26, 26, 46, 0.02),
    0 16rpx 48rpx rgba(91, 110, 245, 0.08);
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.module-card:active {
  transform: scale(0.985);
  box-shadow:
    0 4rpx 8rpx rgba(26, 26, 46, 0.04),
    0 8rpx 24rpx rgba(91, 110, 245, 0.12);
}

/* 左侧主题色条 */
.card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 28rpx 0 0 28rpx;
}

/* 各模块卡片微差异 */
.theme-dice .module-image-wrap {
  background: linear-gradient(135deg, rgba(91, 110, 245, 0.12) 0%, rgba(91, 110, 245, 0.04) 100%);
}

.theme-rps .module-image-wrap {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(236, 72, 153, 0.04) 100%);
}

.theme-picker .module-image-wrap {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.04) 100%);
}

/* 封面图容器 */
.module-image-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  overflow: hidden;
}

.module-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
}

/* 文字与按钮区 */
.module-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.module-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.module-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.module-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  border: 2rpx solid;
  opacity: 0.9;
}

.module-desc {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 12rpx;
  line-height: 1.45;
}

.module-action {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(91, 110, 245, 0.25);
}

.theme-rps .module-action {
  box-shadow: 0 8rpx 20rpx rgba(236, 72, 153, 0.25);
}

.theme-picker .module-action {
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.25);
}

.action-arrow {
  margin-left: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.footer-tip {
  position: relative;
  z-index: 1;
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #c4c9d4;
  margin-top: 48rpx;
}
